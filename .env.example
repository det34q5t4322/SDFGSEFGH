# Токен вашего Telegram-бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleBotTokenHere

# URL вашего сайта расписания для кнопки Telegram Mini App (например: https://schedule.myschool.ru)
# Если тестируете локально, можно использовать туннель Cloudflare / ngrok
WEB_APP_URL=https://your-schedule-domain.ru

# [ВАРИАНТ 1 ДЛЯ СЕРВЕРА В РФ]: Cloudflare Worker Reverse Proxy
# Ссылка на созданный бесплатный воркер Cloudflare (заканчивается на /bot)
TELEGRAM_API_URL=https://your-worker-subdomain.workers.dev/bot

# [ВАРИАНТ 2 ДЛЯ СЕРВЕРА В РФ]: Прокси SOCKS5 или HTTP (раскомментируйте, если используете)
# TELEGRAM_PROXY=socks5://username:password@proxy_host:1080
# TELEGRAM_PROXY=http://username:password@proxy_host:8080

# URL Google Таблицы расписания (CSV экспорт)
SHEET_URL=https://docs.google.com/spreadsheets/d/1RRrdDgLjqfFRYhjbxTdcJY_iNvP3ZEuu/export?format=csv

# Порт веб-сервера
PORT=8000
